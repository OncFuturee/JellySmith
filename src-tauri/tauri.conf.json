{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JellySmith",
  "version": "0.1.0",
  "identifier": "com.yang.jellysmith",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "JellySmith",
        "width": 1707,
        "height": 1032,
        "minWidth": 1000,
        "minHeight": 720,
        "center": true,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: https://image.tmdb.org; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
